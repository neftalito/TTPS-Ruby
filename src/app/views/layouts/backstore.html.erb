<!DOCTYPE html>
<html>
<head>
  <title><%= t(".title") %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= yield :head %>

  <link rel="icon" href="/icon.png" type="image/png">
  <link rel="apple-touch-icon" href="/icon.png">

  <script>
    window.appTranslations = <%= raw frontend_translations_json %>;
  </script>

  <%= vite_client_tag %>
  <%= vite_javascript_tag "application" %>
</head>

<body class="bg-proyecto-bg text-proyecto-text min-h-screen flex flex-col md:flex-row">

<%= flash_modal %>

<aside class="hidden md:flex">
  <%= render "backstore/shared/sidebar" %>
</aside>

<div class="flex-1 flex flex-col">
  <header class="w-full bg-proyecto-secondary shadow px-6 py-4 relative">
    <div class="flex flex-wrap items-center gap-x-4 gap-y-3">

      <%# Izquierda: hamburger + título %>
      <div class="flex items-center gap-3 shrink-0">
        <button
          class="md:hidden bg-proyecto-primary text-proyecto-bg p-2 rounded shadow"
          onclick="document.getElementById('mobileSidebar').classList.remove('hidden')">
          <i class="fa-solid fa-bars"></i>
        </button>
        <h1 class="text-xl font-semibold text-proyecto-primary"><%= t(".heading") %></h1>
      </div>

      <%# Derecha: todo junto, empujado con ml-auto %>
      <div class="ml-auto flex flex-wrap items-center justify-end gap-2">
        <% if user_signed_in? %>
        <span class="flex items-center gap-2 text-proyecto-text whitespace-nowrap">
          <i class="fa-solid fa-user"></i>
          <%= current_user.email.split("@").first.capitalize %>
        </span>

          <%= link_to edit_backstore_user_path(current_user),
                      class: "px-3 py-1 rounded bg-proyecto-secondary text-proyecto-primary hover:bg-proyecto-accent hover:text-proyecto-bg flex items-center gap-2 whitespace-nowrap" do %>
            <i class="fa-solid fa-id-badge"></i>
            <span><%= t("common.navigation.profile") %></span>
          <% end %>

          <%= link_to root_path,
                      class: "px-3 py-1 rounded bg-proyecto-bg text-proyecto-primary border border-proyecto-primary hover:bg-proyecto-primary hover:text-proyecto-bg flex items-center gap-2 whitespace-nowrap" do %>
            <i class="fa-solid fa-store"></i>
            <span><%= t("common.navigation.back_to_store") %></span>
          <% end %>

          <%= button_to destroy_user_session_path,
                        method: :delete,
                        class: "px-3 py-1 bg-proyecto-accent text-proyecto-bg rounded hover:bg-proyecto-primary hover:text-proyecto-bg flex items-center gap-2 whitespace-nowrap" do %>
            <i class="fa-solid fa-right-from-bracket"></i>
            <%= t("common.navigation.logout") %>
          <% end %>
        <% else %>
          <%= link_to new_user_session_path,
                      class: "px-3 py-1 bg-proyecto-primary text-proyecto-bg rounded hover:bg-proyecto-accent flex items-center gap-2 whitespace-nowrap" do %>
            <i class="fa-solid fa-right-to-bracket"></i>
            <%= t(".sign_in") %>
          <% end %>
        <% end %>

        <%# Locale va dentro del grupo derecho, relative propio para anclar el dropdown %>
        <%= render "shared/locale_switcher",
                   wrapper_class: "relative",
                   button_class: "flex items-center gap-2 rounded-lg border border-proyecto-primary bg-white px-3 py-2 text-proyecto-primary shadow-sm transition hover:bg-proyecto-primary hover:text-proyecto-bg cursor-pointer" %>
      </div>

    </div>
  </header>

  <main class="flex-1 p-6">
    <%= yield %>
  </main>

  <div id="mobileSidebar"
       class="hidden fixed inset-0 bg-black bg-opacity-50 z-40 md:hidden"
       onclick="this.classList.add('hidden')">
    <aside class="relative w-full bg-proyecto-primary text-proyecto-bg min-h-full py-6 px-4"
           onclick="event.stopPropagation()">
      <button
        class="absolute top-4 right-4 text-proyecto-bg bg-proyecto-secondary/20 hover:bg-proyecto-secondary/40 rounded-full p-2"
        onclick="document.getElementById('mobileSidebar').classList.add('hidden')">
        <i class="fa-solid fa-xmark"></i>
      </button>

      <%= render "backstore/shared/sidebar" %>
    </aside>
  </div>
</div>
</body>
</html>
