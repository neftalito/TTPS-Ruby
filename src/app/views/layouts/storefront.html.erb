<!DOCTYPE html>
<html>
<head>
  <title><%= t(".title") %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="application-name" content="<%= t("common.app_name") %>">
  <meta name="mobile-web-app-capable" content="yes">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= yield :head %>

  <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
  <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

  <link rel="icon" href="/icon.png" type="image/png">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icon.png">

  <script>
    window.appTranslations = <%= raw frontend_translations_json %>;
  </script>

  <%= vite_client_tag %>
  <%= vite_javascript_tag "application" %>
</head>

<body class="bg-proyecto-bg text-proyecto-text min-h-screen flex flex-col">

<nav class="bg-proyecto-primary text-white shadow sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
    <%= link_to root_path, class: "text-2xl font-bold text-white hover:text-proyecto-secondary" do %>
      <%= t("common.app_name") %>
    <% end %>

    <div class="hidden md:flex items-center gap-6 text-sm font-medium">
      <%= link_to root_path,
                  class: "text-proyecto-secondary hover:text-proyecto-accent transition flex items-center gap-2" do %>
        <i class="fa-solid fa-house"></i>
        <span><%= t("common.navigation.home") %></span>
      <% end %>

      <%= link_to storefront_products_path,
                  class: "text-proyecto-secondary hover:text-proyecto-accent transition flex items-center gap-2" do %>
        <i class="fa-solid fa-compact-disc"></i>
        <span><%= t("common.navigation.catalog") %></span>
      <% end %>

      <% if user_signed_in? %>
        <%= link_to backstore_root_path,
                    class: "text-proyecto-secondary hover:text-proyecto-accent transition flex items-center gap-2" do %>
          <i class="fa-solid fa-gauge-high"></i>
          <span><%= t("common.navigation.admin_panel") %></span>
        <% end %>
      <% else %>
        <%= link_to new_user_session_path,
                    class: "text-proyecto-secondary hover:text-proyecto-accent transition flex items-center gap-2" do %>
          <i class="fa-solid fa-right-to-bracket"></i>
          <span><%= t("common.navigation.sign_in") %></span>
        <% end %>
      <% end %>

      <%= render "shared/locale_switcher",
                 form_class: "inline-block",
                 button_class: "px-3 py-1 rounded-full border border-proyecto-secondary text-proyecto-secondary hover:bg-proyecto-secondary hover:text-proyecto-primary transition flex items-center gap-2" %>
    </div>

    <button onclick="document.getElementById('mobileMenu').classList.toggle('hidden')"
            class="md:hidden text-proyecto-secondary text-2xl">
      <i class="fa-solid fa-bars"></i>
    </button>
  </div>

  <div id="mobileMenu" class="hidden md:hidden bg-proyecto-primary border-t border-proyecto-secondary/40 shadow px-6 py-3 text-white">
    <div class="flex flex-col divide-y divide-proyecto-secondary/30">
      <%= link_to root_path,
                  class: "py-3 flex items-center gap-3 hover:text-proyecto-accent" do %>
        <i class="fa-solid fa-house"></i>
        <span><%= t("common.navigation.home") %></span>
      <% end %>

      <%= link_to storefront_products_path,
                  class: "py-3 flex items-center gap-3 hover:text-proyecto-accent" do %>
        <i class="fa-solid fa-compact-disc"></i>
        <span><%= t("common.navigation.catalog") %></span>
      <% end %>

      <% if user_signed_in? %>
        <%= link_to backstore_root_path,
                    class: "py-3 flex items-center gap-3 hover:text-proyecto-accent" do %>
          <i class="fa-solid fa-gauge-high"></i>
          <span><%= t("common.navigation.admin_panel") %></span>
        <% end %>
      <% else %>
        <%= link_to new_user_session_path,
                    class: "py-3 flex items-center gap-3 hover:text-proyecto-accent" do %>
          <i class="fa-solid fa-right-to-bracket"></i>
          <span><%= t("common.navigation.sign_in") %></span>
        <% end %>
      <% end %>

      <div class="py-3">
        <%= render "shared/locale_switcher",
                   form_class: "w-full",
                   button_class: "w-full px-3 py-2 rounded-lg border border-proyecto-secondary text-proyecto-secondary hover:bg-proyecto-secondary hover:text-proyecto-primary transition flex items-center justify-center gap-2" %>
      </div>
    </div>
  </div>
</nav>

<main class="flex-1 w-full">
  <div class="max-w-7xl mx-auto px-6 py-6">
    <%= yield %>
  </div>
</main>

<footer class="bg-proyecto-primary text-white py-6 mt-10">
  <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-3 gap-6">
    <div>
      <h3 class="text-lg font-semibold mb-2 text-proyecto-secondary"><%= t("common.app_name") %></h3>
      <p class="text-sm text-proyecto-secondary">
        <%= t(".footer_tagline") %>
      </p>
    </div>

    <div>
      <h3 class="text-lg font-semibold mb-2 text-proyecto-secondary"><%= t(".footer_navigation") %></h3>
      <ul class="text-sm text-proyecto-secondary space-y-1">
        <li><%= link_to t("common.navigation.home"), root_path, class: "hover:text-proyecto-accent" %></li>
        <li><%= link_to t("common.navigation.catalog"), storefront_products_path, class: "hover:text-proyecto-accent" %></li>
      </ul>
    </div>

    <div>
      <h3 class="text-lg font-semibold mb-2 text-proyecto-secondary"><%= t(".footer_contact") %></h3>
      <p class="text-sm text-proyecto-secondary">
        contacto@record.ar<br>
        +54 11 5555-5555
      </p>
    </div>
  </div>

  <div class="text-center text-proyecto-secondary text-sm mt-6">
    &copy; <%= Time.current.year %> <%= t("common.app_name") %>. <%= t("common.messages.footer_rights") %>
  </div>
</footer>

</body>
</html>
