<header class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between mb-6">
  <div>
    <p class="text-sm uppercase tracking-widest text-proyecto-text/30"><%= t(".section") %></p>
    <h1 class="text-3xl font-bold text-proyecto-primary"><%= t(".title") %></h1>
    <p class="text-proyecto-text/60"><%= t(".subtitle") %></p>
  </div>

  <% if can? :create, Product %>
    <%= link_to new_backstore_product_path,
                class: "inline-flex items-center gap-2 px-4 py-2 rounded-md bg-proyecto-primary text-proyecto-bg font-semibold hover:bg-proyecto-accent w-full sm:w-auto justify-center" do %>
      <i class="fa-solid fa-circle-plus"></i>
      <span><%= t("common.actions.new_product") %></span>
    <% end %>
  <% end %>
</header>

<div class="bg-white p-4 mb-4 rounded-lg border border-proyecto-secondary shadow">
  <%= form_with url: backstore_products_path,
                method: :get,
                local: true,
                class: "space-y-4" do |f| %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
      <div class="w-full">
        <%= f.label :name_q, t(".filters.name_label"), class: "block text-sm font-medium text-proyecto-primary" %>
        <%= f.text_field :name_q, value: params[:name_q],
                         placeholder: t(".filters.name_placeholder"),
                         class: "mt-1 px-3 py-1 border rounded-md w-full" %>
      </div>

      <div class="w-full">
        <%= f.label :author_q, t(".filters.author_label"), class: "block text-sm font-medium text-proyecto-primary" %>
        <%= f.text_field :author_q, value: params[:author_q],
                         placeholder: t(".filters.author_placeholder"),
                         class: "mt-1 px-3 py-1 border rounded-md w-full" %>
      </div>

      <div class="w-full">
        <%= f.label :category_id, t("common.labels.genre"), class: "block text-sm font-medium text-proyecto-primary" %>
        <%= f.select :category_id,
                     [[t(".filters.all_genres"), ""]] + Category.all.map { |c| [c.name, c.id] },
                     { selected: params[:category_id] },
                     class: "mt-1 px-3 py-1 border rounded-md w-full" %>
      </div>

      <div class="w-full">
        <%= f.label :status, t("common.labels.status"), class: "block text-sm font-medium text-proyecto-primary" %>
        <%= f.select :status,
                     [[t(".filters.active"), ""], [t(".filters.deleted"), "deleted"], [t("common.options.all"), "all"]],
                     { selected: params[:status] },
                     class: "mt-1 px-3 py-1 border rounded-md w-full" %>
      </div>
      <div class="w-full">
        <%= f.label :product_type, t("common.labels.type"), class: "block text-sm font-medium text-proyecto-primary" %>
        <%= f.select :product_type,
                     [[t(".filters.all_types"), "all"], [t("products.types.vinyl"), "vinyl"], [t("products.types.cd"), "cd"]],
                     { selected: params[:product_type] || "all" },
                     class: "mt-1 px-3 py-1 border rounded-md w-full" %>
      </div>

      <div class="w-full">
        <%= f.label :condition, t("common.labels.condition"), class: "block text-sm font-medium text-proyecto-primary" %>
        <%= f.select :condition,
                     [[t(".filters.all_conditions"), "all"], [t("products.conditions.new"), "new"], [t("products.conditions.used"), "used"]],
                     { selected: params[:condition] || "all" },
                     class: "mt-1 px-3 py-1 border rounded-md w-full" %>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 sm:max-w-md">
      <%= f.button type: :submit,
                   name: nil,
                   class: "inline-flex items-center justify-center gap-2 px-4 py-2 bg-proyecto-primary text-proyecto-bg rounded-md hover:bg-proyecto-accent w-full text-center cursor-pointer" do %>
        <i class="fa-solid fa-filter"></i>
        <span><%= t("common.actions.filter") %></span>
      <% end %>

      <%= link_to backstore_products_path,
                  class: "inline-flex items-center justify-center gap-2 px-4 py-2 bg-proyecto-primary text-proyecto-bg rounded-md hover:bg-proyecto-accent w-full text-center" do %>
        <i class="fa-solid fa-eraser"></i>
        <span><%= t("common.actions.clear_filters") %></span>
      <% end %>
    </div>
  <% end %>
</div>

<% product_columns = [
  { header: I18n.t("backstore.products.index.headers.id"), attribute: :id },
  {
    header: I18n.t("backstore.products.index.headers.product"),
    cell_class: "px-6 py-4",
    value: ->(product) do
      content_tag(:div, class: "flex items-center gap-3") do
        safe_join([
          product_cover_thumbnail(product, size: 48, wrapper_class: "shrink-0"),
          content_tag(:div, class: "min-w-0") do
            safe_join([
              content_tag(:div, product.name, class: "font-semibold text-proyecto-primary break-words"),
              content_tag(:div, product.author, class: "text-xs text-proyecto-text/60 break-words")
            ])
          end
        ])
      end
    end
  },
  { header: I18n.t("backstore.products.index.headers.type"), attribute: :label_for_type },
  { header: I18n.t("backstore.products.index.headers.condition"), attribute: :label_for_condition },
  {
    header: I18n.t("backstore.products.index.headers.genre"),
    value: ->(product) { product.category&.name || I18n.t("common.states.no_genre") }
  },
  {
    header: I18n.t("backstore.products.index.headers.price"),
    cell_class: "px-6 py-4 whitespace-nowrap font-semibold text-proyecto-primary",
    value: ->(product) { number_to_currency(product.price || 0, unit: "$", separator: ",", delimiter: ".", format: "%u%n") }
  },
  {
    header: I18n.t("backstore.products.index.headers.stock"),
    cell_class: "px-6 py-4 whitespace-nowrap font-semibold",
    value: ->(product) do
      stock_class = product.stock.to_i.positive? ? "text-proyecto-success" : "text-proyecto-error"
      content_tag(:span, product.stock || 0, class: stock_class)
    end
  },
  {
    header: I18n.t("backstore.products.index.headers.status"),
    cell_class: "px-6 py-4 whitespace-nowrap",
    value: ->(product) do
      if product.deleted?
        content_tag(:span, I18n.t("common.states.deleted"), class: "px-3 py-1 rounded-full text-xs font-semibold bg-proyecto-error/10 text-proyecto-error")
      else
        content_tag(:span, I18n.t("common.states.active"), class: "px-3 py-1 rounded-full text-xs font-semibold bg-proyecto-success/10 text-proyecto-success")
      end
    end
  }
] %>

<% product_actions = lambda do |product|
  if product.deleted?
    if can? :restore, product
      link_to I18n.t("common.actions.restore"),
              restore_backstore_product_path(product),
              data: { turbo_method: :patch, turbo_confirm: I18n.t("backstore.products.index.confirmations.restore") },
              class: "px-3 py-2 bg-proyecto-success text-white hover:bg-proyecto-success/90 rounded-md text-sm w-full sm:w-auto text-center"
    end
  else
    buttons = []

    if can? :read, product
      buttons << link_to(
        I18n.t("common.actions.view"),
        backstore_product_path(product),
        class: "px-3 py-2 bg-proyecto-info text-proyecto-bg hover:bg-proyecto-info/90 rounded-md text-sm w-full sm:w-auto text-center"
      )
    end

    if can? :update, product
      buttons << link_to(
        I18n.t("common.actions.edit"),
        edit_backstore_product_path(product),
        class: "px-3 py-2 bg-proyecto-primary text-proyecto-bg hover:bg-proyecto-primary/90 rounded-md text-sm w-full sm:w-auto text-center"
      )
    end

    if can? :destroy, product
      buttons << link_to(
        I18n.t("common.actions.delete"),
        backstore_product_path(product),
        data: { turbo_method: :delete, turbo_confirm: I18n.t("backstore.products.index.confirmations.delete") },
        class: "px-3 py-2 bg-proyecto-error text-proyecto-bg hover:bg-proyecto-error/90 rounded-md text-sm w-full sm:w-auto text-center"
      )
    end

    safe_join(buttons)
  end
end %>

<div class="shadow border border-proyecto-secondary rounded-lg bg-white p-2 sm:p-4">
  <%= render "backstore/shared/resource_table",
             collection: @products,
             columns: product_columns,
             row_class: ->(product) { product.deleted? ? "bg-proyecto-secondary/20" : nil },
             empty_message: t(".empty_message"),
             actions: product_actions %>
</div>

<%= render "shared/pagination", collection: @products, params: request.query_parameters %>
