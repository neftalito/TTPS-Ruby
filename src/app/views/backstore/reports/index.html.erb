<div class="mx-auto mb-10 max-w-[95%]" data-controller="report-filters">
  <% btn_class = "px-4 py-2 text-sm font-medium rounded-md focus:outline-none transition-colors whitespace-nowrap" %>
  <% active_class = "bg-proyecto-primary text-proyecto-bg shadow-sm" %>
  <% inactive_class = "text-proyecto-primary hover:bg-proyecto-secondary hover:text-proyecto-primary" %>

  <header class="mb-8 flex flex-col gap-6 xl:flex-row xl:items-start xl:justify-between">
    <div>
      <p class="text-sm uppercase tracking-widest text-proyecto-text/30">Analitica</p>
      <h1 class="text-3xl font-bold text-proyecto-primary">Reporte de ventas</h1>
      <p class="mt-1 text-proyecto-text/60">
        Visualizacion numerica y grafica de las ventas confirmadas del sistema.
      </p>
      <div class="mt-3 flex flex-wrap gap-2">
        <% report_filter_badges(@report).each do |badge| %>
          <span class="rounded-full bg-proyecto-secondary/20 px-3 py-1 text-xs font-semibold text-proyecto-primary">
            <%= badge %>
          </span>
        <% end %>
      </div>
    </div>

    <div class="flex flex-wrap gap-2">
      <%= link_to backstore_reports_path(@export_params.merge(format: :csv)),
                  class: "inline-flex items-center gap-2 rounded-md bg-green-600 px-4 py-2 text-sm font-medium text-white shadow-sm transition hover:bg-green-700" do %>
        <i class="fa-solid fa-file-csv"></i>
        CSV
      <% end %>

      <%= link_to backstore_reports_path(@export_params.merge(format: :pdf)),
                  target: "_blank",
                  class: "inline-flex items-center gap-2 rounded-md bg-red-600 px-4 py-2 text-sm font-medium text-white shadow-sm transition hover:bg-red-700" do %>
        <i class="fa-solid fa-file-pdf"></i>
        PDF
      <% end %>
    </div>
  </header>

  <section class="mb-8 rounded-2xl border border-proyecto-text/10 bg-white p-5 shadow-sm">
    <div class="mb-4 inline-flex max-w-full gap-1 overflow-x-auto rounded-md border border-proyecto-text/10 bg-proyecto-secondary/20 p-1">
      <%= link_to "Hoy",
                  backstore_reports_path(report_quick_range_params("today")),
                  class: "#{btn_class} #{@range == 'today' ? active_class : inactive_class}" %>
      <%= link_to "Esta semana",
                  backstore_reports_path(report_quick_range_params("week")),
                  class: "#{btn_class} #{@range == 'week' ? active_class : inactive_class}" %>
      <%= link_to "Este mes",
                  backstore_reports_path(report_quick_range_params("month")),
                  class: "#{btn_class} #{@range == 'month' ? active_class : inactive_class}" %>
      <%= link_to "Este año",
                  backstore_reports_path(report_quick_range_params("year")),
                  class: "#{btn_class} #{@range == 'year' ? active_class : inactive_class}" %>
      <%= link_to "Historico",
                  backstore_reports_path(report_quick_range_params("all")),
                  class: "#{btn_class} #{@range == 'all' ? active_class : inactive_class}" %>
      <button type="button"
              data-action="report-filters#toggle"
              class="<%= btn_class %> <%= @range == 'custom' ? active_class : inactive_class %>">
        Personalizado
      </button>
    </div>

    <div data-report-filters-target="customRange" class="<%= @range == 'custom' ? '' : 'hidden' %>">
      <%= form_with url: backstore_reports_path, method: :get, class: "grid grid-cols-1 gap-4 lg:grid-cols-5" do |f| %>
        <%= f.hidden_field :range, value: "custom" %>

        <div>
          <%= f.label :start_date, "Desde", class: "mb-1 block text-sm font-semibold text-proyecto-primary" %>
          <%= f.date_field :start_date,
                           value: @start_date || Date.current,
                           class: "w-full rounded-md border-proyecto-text/20 bg-proyecto-bg text-sm text-proyecto-primary focus:border-proyecto-accent focus:ring-proyecto-accent",
                           data: { report_filters_target: "startDate", action: "change->report-filters#updateConstraints" } %>
        </div>

        <div>
          <%= f.label :end_date, "Hasta", class: "mb-1 block text-sm font-semibold text-proyecto-primary" %>
          <%= f.date_field :end_date,
                           value: @end_date || Date.current,
                           class: "w-full rounded-md border-proyecto-text/20 bg-proyecto-bg text-sm text-proyecto-primary focus:border-proyecto-accent focus:ring-proyecto-accent",
                           data: { report_filters_target: "endDate", action: "change->report-filters#updateConstraints" } %>
        </div>

        <div>
          <%= f.label :product_type, "Tipo", class: "mb-1 block text-sm font-semibold text-proyecto-primary" %>
          <%= f.select :product_type,
                       options_for_select(report_product_type_options, @report.product_type),
                       {},
                       class: "w-full rounded-md border-proyecto-text/20 bg-proyecto-bg text-sm text-proyecto-primary focus:border-proyecto-accent focus:ring-proyecto-accent" %>
        </div>

        <div>
          <%= f.label :category_id, "Genero", class: "mb-1 block text-sm font-semibold text-proyecto-primary" %>
          <%= f.select :category_id,
                       options_for_select([["Todos", nil]] + @filter_categories.map { |category| [category.name, category.id] }, @report.category_id),
                       {},
                       class: "w-full rounded-md border-proyecto-text/20 bg-proyecto-bg text-sm text-proyecto-primary focus:border-proyecto-accent focus:ring-proyecto-accent" %>
        </div>

        <div>
          <%= f.label :user_id, "Empleado", class: "mb-1 block text-sm font-semibold text-proyecto-primary" %>
          <%= f.select :user_id,
                       options_for_select([["Todos", nil]] + @filter_users.map { |user| [user.email, user.id] }, @report.user_id),
                       {},
                       class: "w-full rounded-md border-proyecto-text/20 bg-proyecto-bg text-sm text-proyecto-primary focus:border-proyecto-accent focus:ring-proyecto-accent" %>
        </div>

        <div class="flex flex-col gap-2 lg:col-span-5 sm:flex-row sm:justify-end">
          <%= link_to "Limpiar filtros",
                      backstore_reports_path,
                      class: "inline-flex items-center justify-center rounded-md border border-proyecto-text/10 px-4 py-2 text-sm font-semibold text-proyecto-primary transition hover:bg-proyecto-secondary/20" %>
          <%= f.button "Aplicar filtros",
                       class: "inline-flex items-center justify-center rounded-md bg-proyecto-primary px-4 py-2 text-sm font-semibold text-proyecto-bg transition hover:bg-proyecto-accent" %>
        </div>
      <% end %>
    </div>
  </section>

  <section class="mb-8 grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-4">
    <article class="group relative overflow-hidden rounded-2xl border border-proyecto-text/5 bg-proyecto-secondary/10 p-6 transition-all hover:border-proyecto-accent/30">
      <div class="absolute right-0 top-0 h-full w-1 bg-proyecto-success"></div>
      <p class="text-xs font-bold uppercase tracking-wider text-proyecto-text/60">Total recaudado</p>
      <p class="mt-2 text-3xl font-bold text-proyecto-primary transition-colors group-hover:text-proyecto-success">
        <%= number_to_currency(@total_revenue, unit: "$", separator: ",", delimiter: ".", format: "%u%n") %>
      </p>
      <p class="mt-2 text-xs text-proyecto-text/40">Solo se consideran ventas confirmadas.</p>
    </article>

    <article class="group relative overflow-hidden rounded-2xl border border-proyecto-text/5 bg-proyecto-secondary/10 p-6 transition-all hover:border-proyecto-accent/30">
      <div class="absolute right-0 top-0 h-full w-1 bg-blue-500"></div>
      <p class="text-xs font-bold uppercase tracking-wider text-proyecto-text/60">Cantidad de ventas</p>
      <p class="mt-2 text-3xl font-bold text-proyecto-primary transition-colors group-hover:text-blue-500">
        <%= @total_sales %>
      </p>
      <p class="mt-2 text-xs text-proyecto-text/40">Ventas que cumplen los filtros activos.</p>
    </article>

    <article class="group relative overflow-hidden rounded-2xl border border-proyecto-text/5 bg-proyecto-secondary/10 p-6 transition-all hover:border-proyecto-accent/30">
      <div class="absolute right-0 top-0 h-full w-1 bg-purple-500"></div>
      <p class="text-xs font-bold uppercase tracking-wider text-proyecto-text/60">Promedio por venta</p>
      <p class="mt-2 text-3xl font-bold text-proyecto-primary transition-colors group-hover:text-purple-500">
        <%= number_to_currency(@average_ticket, unit: "$", separator: ",", delimiter: ".", format: "%u%n") %>
      </p>
      <p class="mt-2 text-xs text-proyecto-text/40">Importe promedio dentro del reporte filtrado.</p>
    </article>

    <article class="group relative overflow-hidden rounded-2xl border border-proyecto-text/5 bg-proyecto-secondary/10 p-6 transition-all hover:border-proyecto-accent/30">
      <div class="absolute right-0 top-0 h-full w-1 bg-orange-500"></div>
      <p class="text-xs font-bold uppercase tracking-wider text-proyecto-text/60">Productos vendidos</p>
      <p class="mt-2 text-3xl font-bold text-proyecto-primary transition-colors group-hover:text-orange-500">
        <%= @total_items %>
      </p>
      <p class="mt-2 text-xs text-proyecto-text/40">Cantidad total de unidades vendidas.</p>
    </article>
  </section>

  <% if @report.empty? %>
    <section class="rounded-2xl border border-proyecto-text/10 bg-white p-12 text-center shadow-sm">
      <div class="mx-auto mb-4 h-12 w-12 text-proyecto-text/30">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
      </div>
      <h2 class="text-lg font-semibold text-proyecto-primary">No hay ventas para esos filtros</h2>
      <p class="mt-1 text-sm text-proyecto-text/60">Proba otro rango de fechas, genero, tipo o empleado.</p>
    </section>
  <% else %>
    <section class="mb-8 grid grid-cols-1 gap-6 xl:grid-cols-3">
      <article class="rounded-2xl border border-proyecto-text/10 bg-white p-5 shadow-sm">
        <div class="mb-4 flex items-center justify-between gap-4">
          <div>
            <h2 class="text-lg font-bold text-proyecto-primary">Ventas por tipo</h2>
            <p class="text-sm text-proyecto-text/60">Distribucion de unidades entre CD y vinilos.</p>
          </div>
          <span class="rounded-full bg-proyecto-accent/10 px-3 py-1 text-xs font-semibold text-proyecto-accent">Unidades</span>
        </div>
        <%= pie_chart @sales_by_product_type,
                      donut: true,
                      height: "300px",
                      colors: ["#0f766e", "#ea580c"],
                      legend: "bottom" %>
      </article>

      <article class="rounded-2xl border border-proyecto-text/10 bg-white p-5 shadow-sm xl:col-span-2">
        <div class="mb-4 flex items-center justify-between gap-4">
          <div>
            <h2 class="text-lg font-bold text-proyecto-primary">Ventas por genero musical</h2>
            <p class="text-sm text-proyecto-text/60">Cantidad de unidades vendidas por genero.</p>
          </div>
          <span class="rounded-full bg-proyecto-accent/10 px-3 py-1 text-xs font-semibold text-proyecto-accent">Ranking</span>
        </div>
        <%= column_chart @sales_by_genre,
                         height: "300px",
                         colors: ["#1d4ed8"],
                         xtitle: "Genero",
                         ytitle: "Unidades" %>
      </article>
    </section>

    <section class="mb-8 rounded-2xl border border-proyecto-text/10 bg-white p-5 shadow-sm">
      <div class="mb-4 flex items-center justify-between gap-4">
        <div>
          <h2 class="text-lg font-bold text-proyecto-primary">Top 5 productos mas vendidos</h2>
          <p class="text-sm text-proyecto-text/60">Productos con mayor cantidad de unidades vendidas en el periodo.</p>
        </div>
        <span class="rounded-full bg-proyecto-accent/10 px-3 py-1 text-xs font-semibold text-proyecto-accent">Top 5</span>
      </div>

      <div class="mb-6">
        <%= bar_chart @top_products_chart,
                      height: "320px",
                      colors: ["#be123c"],
                      xtitle: "Unidades",
                      ytitle: "Producto" %>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-proyecto-text/10">
          <thead class="bg-proyecto-secondary/10">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-proyecto-text/60">#</th>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-proyecto-text/60">Producto</th>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-proyecto-text/60">Genero</th>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-proyecto-text/60">Tipo</th>
              <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider text-proyecto-text/60">Unidades</th>
              <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider text-proyecto-text/60">Recaudado</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-proyecto-text/10 bg-transparent">
            <% @top_products.each_with_index do |product, index| %>
              <tr class="transition-colors hover:bg-proyecto-secondary/10">
                <td class="px-6 py-4 text-sm font-bold text-proyecto-text/40"><%= index + 1 %></td>
                <td class="px-6 py-4">
                  <div class="text-sm font-medium text-proyecto-primary"><%= product.product_name %></div>
                  <div class="text-sm text-proyecto-text/60"><%= product.product_author %></div>
                </td>
                <td class="px-6 py-4 text-sm text-proyecto-text/60"><%= product.category_name || "Sin genero" %></td>
                <td class="px-6 py-4 text-sm text-proyecto-text/60"><%= @report.human_product_type(product.product_type) %></td>
                <td class="px-6 py-4 text-right text-sm font-bold text-proyecto-accent"><%= product.total_quantity %></td>
                <td class="px-6 py-4 text-right text-sm font-semibold text-proyecto-primary">
                  <%= number_to_currency(product.total_revenue, unit: "$", separator: ",", delimiter: ".", format: "%u%n") %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>
</div>
