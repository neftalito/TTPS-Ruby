<style>
  .header {
    background-color: #1f2937;
    color: #ffffff;
    margin-bottom: 30px;
    overflow: hidden;
    padding: 30px 40px;
  }

  .header-left { float: left; width: 60%; }
  .header-right { float: right; text-align: right; width: 40%; }
  .report-title { font-size: 28px; font-weight: bold; letter-spacing: 1px; margin: 0; text-transform: uppercase; }
  .brand-sub { font-size: 12px; margin-top: 5px; opacity: 0.8; }
  .meta-title { color: #818cf8; font-size: 14px; font-weight: bold; margin: 0; text-transform: uppercase; }
  .meta-value { font-size: 13px; margin-top: 2px; opacity: 0.9; }

  table.data-table { border-collapse: collapse; margin-bottom: 30px; width: 100%; }
  table.data-table th {
    background-color: #f3f4f6;
    border-bottom: 2px solid #e5e7eb;
    color: #374151;
    font-size: 11px;
    font-weight: bold;
    padding: 12px 10px;
    text-align: left;
    text-transform: uppercase;
  }
  table.data-table td {
    border-bottom: 1px solid #e5e7eb;
    color: #1f2937;
    font-size: 12px;
    padding: 12px 10px;
  }

  .kpi-table { border-collapse: separate; border-spacing: 10px; margin-bottom: 40px; width: 100%; }
  .kpi-card {
    background-color: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    padding: 15px;
    vertical-align: top;
    width: 25%;
  }
  .kpi-label { color: #6b7280; font-size: 10px; font-weight: bold; letter-spacing: 0.5px; text-transform: uppercase; }
  .kpi-value { color: #111827; font-size: 20px; font-weight: bold; margin: 8px 0; }
  .kpi-sub { color: #9ca3af; font-size: 10px; }

  .filters-table { border-collapse: collapse; margin-bottom: 30px; width: 100%; }
  .filters-table td { border: 1px solid #e5e7eb; font-size: 11px; padding: 8px 10px; }

  .border-green { border-top: 4px solid #10b981; }
  .border-blue { border-top: 4px solid #3b82f6; }
  .border-purple { border-top: 4px solid #a855f7; }
  .border-orange { border-top: 4px solid #f97316; }

  .section-title {
    border-bottom: 1px solid #eeeeee;
    color: #374151;
    font-size: 16px;
    font-weight: bold;
    margin-bottom: 15px;
    padding-bottom: 5px;
  }

  .text-right { text-align: right; }
  .footer {
    border-top: 1px solid #e5e7eb;
    color: #9ca3af;
    font-size: 10px;
    margin-top: 40px;
    padding-top: 20px;
    text-align: center;
  }
</style>

<div style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; width: 100%;">
  <div class="header">
    <div class="header-left">
      <h1 class="report-title"><%= t("backstore.reports.index_pdf.title") %></h1>
      <p class="brand-sub"><%= t("backstore.reports.index_pdf.subtitle") %></p>
    </div>
    <div class="header-right">
      <div style="margin-bottom: 10px;">
        <p class="meta-title"><%= t("backstore.reports.index_pdf.issue_date") %></p>
        <p class="meta-value"><%= l(Date.current, format: :long) %></p>
      </div>
      <div>
        <p class="meta-title"><%= t("backstore.reports.index_pdf.analyzed_period") %></p>
        <p class="meta-value"><%= @report.date_range_label %></p>
      </div>
    </div>
  </div>

  <div style="padding: 0 40px;">
    <h3 class="section-title"><%= t("backstore.reports.index_pdf.applied_filters") %></h3>

    <table class="filters-table">
      <tr>
        <td><strong><%= t("backstore.reports.index_pdf.filters.product_type") %></strong></td>
        <td><%= @report.human_product_type %></td>
        <td><strong><%= t("backstore.reports.index_pdf.filters.genre") %></strong></td>
        <td><%= Category.find_by(id: @report.category_id)&.name || t("common.options.all") %></td>
      </tr>
      <tr>
        <td><strong><%= t("backstore.reports.index_pdf.filters.employee") %></strong></td>
        <td><%= User.find_by(id: @report.user_id)&.email || t("common.options.all") %></td>
        <td><strong><%= t("backstore.reports.index_pdf.filters.considered_sales") %></strong></td>
        <td><%= @total_sales %></td>
      </tr>
    </table>

    <h3 class="section-title"><%= t("backstore.reports.index_pdf.executive_summary") %></h3>

    <table class="kpi-table">
      <tr>
        <td class="kpi-card border-green">
          <div class="kpi-label"><%= t("backstore.reports.index_pdf.cards.total_revenue_title") %></div>
          <div class="kpi-value" style="color: #059669;">
            <%= number_to_currency(@total_revenue, unit: "$", separator: ",", delimiter: ".", format: "%u%n") %>
          </div>
          <div class="kpi-sub"><%= t("backstore.reports.index_pdf.cards.total_revenue_subtitle") %></div>
        </td>

        <td class="kpi-card border-blue">
          <div class="kpi-label"><%= t("backstore.reports.index_pdf.cards.total_sales_title") %></div>
          <div class="kpi-value" style="color: #2563eb;">
            <%= @total_sales %>
          </div>
          <div class="kpi-sub"><%= t("backstore.reports.index_pdf.cards.total_sales_subtitle") %></div>
        </td>

        <td class="kpi-card border-purple">
          <div class="kpi-label"><%= t("backstore.reports.index_pdf.cards.average_ticket_title") %></div>
          <div class="kpi-value" style="color: #7c3aed;">
            <%= number_to_currency(@average_ticket, unit: "$", separator: ",", delimiter: ".", format: "%u%n") %>
          </div>
          <div class="kpi-sub"><%= t("backstore.reports.index_pdf.cards.average_ticket_subtitle") %></div>
        </td>

        <td class="kpi-card border-orange">
          <div class="kpi-label"><%= t("backstore.reports.index_pdf.cards.total_items_title") %></div>
          <div class="kpi-value" style="color: #ea580c;">
            <%= @total_items %>
          </div>
          <div class="kpi-sub"><%= t("backstore.reports.index_pdf.cards.total_items_subtitle") %></div>
        </td>
      </tr>
    </table>

    <h3 class="section-title"><%= t("backstore.reports.index_pdf.sales_by_type.title") %></h3>

    <table class="data-table">
      <thead>
        <tr>
          <th width="70%"><%= t("backstore.reports.index_pdf.sales_by_type.headers.type") %></th>
          <th width="30%" class="text-right"><%= t("backstore.reports.index_pdf.sales_by_type.headers.units") %></th>
        </tr>
      </thead>
      <tbody>
        <% @sales_by_product_type.each do |label, quantity| %>
          <tr>
            <td><%= label %></td>
            <td class="text-right"><%= quantity %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <h3 class="section-title"><%= t("backstore.reports.index_pdf.sales_by_genre.title") %></h3>

    <table class="data-table">
      <thead>
        <tr>
          <th width="70%"><%= t("backstore.reports.index_pdf.sales_by_genre.headers.genre") %></th>
          <th width="30%" class="text-right"><%= t("backstore.reports.index_pdf.sales_by_genre.headers.units") %></th>
        </tr>
      </thead>
      <tbody>
        <% @sales_by_genre.each do |genre, quantity| %>
          <tr>
            <td><%= genre %></td>
            <td class="text-right"><%= quantity %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <h3 class="section-title"><%= t("backstore.reports.index_pdf.top_products.title") %></h3>

    <table class="data-table">
      <thead>
        <tr>
          <th width="5%">#</th>
          <th width="35%"><%= t("backstore.reports.index_pdf.top_products.headers.product_artist") %></th>
          <th width="20%"><%= t("backstore.reports.index_pdf.top_products.headers.genre") %></th>
          <th width="15%"><%= t("backstore.reports.index_pdf.top_products.headers.type") %></th>
          <th width="10%" class="text-right"><%= t("backstore.reports.index_pdf.top_products.headers.units") %></th>
          <th width="15%" class="text-right"><%= t("backstore.reports.index_pdf.top_products.headers.revenue") %></th>
        </tr>
      </thead>
      <tbody>
        <% @top_products.each_with_index do |product, index| %>
          <tr>
            <td style="color: #6b7280; font-weight: bold;"><%= index + 1 %></td>
            <td>
              <div style="color: #111111; font-size: 13px; font-weight: bold;"><%= product.product_name %></div>
              <div style="color: #6b7280; font-size: 11px;"><%= product.product_author %></div>
            </td>
            <td><%= product.category_name || "-" %></td>
            <td><%= @report.human_product_type(product.product_type) %></td>
            <td class="text-right"><%= product.total_quantity %></td>
            <td class="text-right"><%= number_to_currency(product.total_revenue, unit: "$", separator: ",", delimiter: ".", format: "%u%n") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="footer">
    <p><%= t("backstore.reports.index_pdf.footer_line_one") %></p>
    <p><%= t("backstore.reports.index_pdf.footer_line_two") %></p>
  </div>
</div>
