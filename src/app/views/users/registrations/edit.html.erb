<div class="max-w-3xl mx-auto p-8 md:p-12 bg-proyecto-secondary/10 rounded-3xl shadow-2xl border border-proyecto-text/10 font-sans">
  <header class="mb-10 border-b border-proyecto-text/10 pb-5 text-center">
    <h1 class="text-4xl font-extrabold text-proyecto-primary tracking-widest uppercase">
      <%= t(".title") %>
    </h1>
    <p class="text-lg text-proyecto-text/60 mt-2 font-light">
      <%= t(".subtitle") %>
    </p>
  </header>

  <%= form_for(resource, as: resource_name,
               url: registration_path(resource_name),
               html: { method: :put, class: "space-y-10" }) do |f| %>
    <% if resource.errors.any? %>
      <div class="p-4 rounded-lg bg-proyecto-error/10 border border-proyecto-error/20 text-proyecto-error">
        <h4 class="font-bold mb-2 flex items-center gap-2">
          <i class="fa-solid fa-circle-exclamation"></i>
          <%= t(".errors_title") %>
        </h4>
        <ul class="list-disc list-inside text-sm ml-5">
          <% resource.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="p-8 border border-proyecto-text/10 rounded-xl bg-proyecto-bg/50 shadow-sm space-y-6">
      <div class="space-y-2">
        <p class="text-sm uppercase tracking-widest text-proyecto-primary font-semibold"><%= t(".account_title") %></p>
        <p class="text-sm text-proyecto-text/70"><%= t(".account_subtitle") %></p>
      </div>

      <div class="space-y-1">
        <%= f.label :email, t("common.labels.email"), class: "block text-sm font-medium text-proyecto-text/80" %>
        <%= f.email_field :email,
                          autofocus: true,
                          autocomplete: "email",
                          class: "w-full px-4 py-3 rounded-lg border border-proyecto-text/20 bg-white text-proyecto-primary placeholder-proyecto-text/40 focus:border-proyecto-accent focus:ring-proyecto-accent transition duration-200" %>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <p class="text-sm text-proyecto-accent font-medium">
          <i class="fa-solid fa-clock mr-2"></i>
          <%= t(".pending_confirmation", email: resource.unconfirmed_email) %>
        </p>
      <% end %>
    </div>

    <div class="p-8 border border-proyecto-text/10 rounded-xl bg-proyecto-bg/50 shadow-sm space-y-6">
      <div class="space-y-2">
        <p class="text-sm uppercase tracking-widest text-proyecto-primary font-semibold"><%= t(".security_title") %></p>
        <p class="text-sm text-proyecto-text/70"><%= t(".security_subtitle") %></p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="space-y-1 md:col-span-2">
          <%= f.label :current_password, t(".current_password"), class: "block text-sm font-medium text-proyecto-text/80" %>
          <%= f.password_field :current_password,
                               autocomplete: "current-password",
                               class: "w-full px-4 py-3 rounded-lg border border-proyecto-text/20 bg-white text-proyecto-primary placeholder-proyecto-text/40 focus:border-proyecto-accent focus:ring-proyecto-accent transition duration-200" %>
          <p class="text-xs text-proyecto-text/60"><%= t(".required_for_changes") %></p>
        </div>

        <div class="space-y-1">
          <%= f.label :password, t(".new_password"), class: "block text-sm font-medium text-proyecto-text/80" %>
          <%= f.password_field :password,
                               autocomplete: "new-password",
                               placeholder: t(".password_placeholder"),
                               class: "w-full px-4 py-3 rounded-lg border border-proyecto-text/20 bg-white text-proyecto-primary placeholder-proyecto-text/40 focus:border-proyecto-accent focus:ring-proyecto-accent transition duration-200" %>
          <% if @minimum_password_length %>
            <p class="text-xs text-proyecto-text/60"><%= t(".minimum_password_length", count: @minimum_password_length) %></p>
          <% end %>
        </div>

        <div class="space-y-1">
          <%= f.label :password_confirmation, t(".confirm_new_password"), class: "block text-sm font-medium text-proyecto-text/80" %>
          <%= f.password_field :password_confirmation,
                               autocomplete: "new-password",
                               class: "w-full px-4 py-3 rounded-lg border border-proyecto-text/20 bg-white text-proyecto-primary placeholder-proyecto-text/40 focus:border-proyecto-accent focus:ring-proyecto-accent transition duration-200" %>
          <p class="text-xs text-proyecto-text/60"><%= t(".optional") %></p>
        </div>
      </div>
    </div>

    <div class="pt-6 border-t border-proyecto-text/10 flex flex-col sm:flex-row justify-end gap-4">
      <%= link_to backstore_root_path,
                  class: "inline-flex items-center justify-center gap-2 px-8 py-3 border border-proyecto-text/20 rounded-lg text-proyecto-text hover:bg-proyecto-secondary/20 transition duration-200 font-medium text-center" do %>
        <i class="fa-solid fa-arrow-left"></i>
        <span><%= t("common.actions.cancel") %></span>
      <% end %>

      <%= f.button type: :submit,
                   class: "inline-flex items-center justify-center gap-2 px-8 py-3 bg-proyecto-primary text-proyecto-bg rounded-lg font-bold hover:bg-proyecto-accent transition duration-200 cursor-pointer shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 text-center" do %>
        <i class="fa-solid fa-floppy-disk"></i>
        <span><%= t("common.actions.save_changes") %></span>
      <% end %>
    </div>
  <% end %>
</div>
